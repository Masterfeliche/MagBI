# Copy to .env (git-ignored). Required when MAGBI_ENVIRONMENT=prod.
MAGBI_ENVIRONMENT=dev
# Generate: python -c "from magbi.storage.credentials import generate_key; print(generate_key())"
MAGBI_CREDENTIAL_KEY=
MAGBI_JWT_SECRET=change-me-in-production

# The admin API has no authentication until Sprint 7. Outside dev it stays off (503)
# unless this is true. Only enable on a trusted network.
MAGBI_INSECURE_ADMIN_API=false
# Comma-separated hosts the API may connect to (empty = any host). Recommended for real use.
MAGBI_CONNECTOR_ALLOWED_HOSTS=
